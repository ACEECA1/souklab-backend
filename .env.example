# Server Configuration
PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/souklab_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# JWT Security (Must be at least 256-bit / 32 bytes string for HS256)
APP_JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long_here
APP_JWT_ACCESS_EXP=3600000
APP_JWT_REFRESH_EXP=86400000

# Hibernate Search & Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
HIBERNATE_SEARCH_SCHEMA_MANAGEMENT=none

# File Upload & Storage Locations
APP_STORAGE_UPLOADS=storage/uploads
APP_STORAGE_THUMBNAILS=storage/thumbnails
APP_STORAGE_INDEXES=storage/indexes

# Mail Configuration (SMTP / MailerSend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_EMAIL_USE_SMTP=true
MAILERSEND_API_KEY=
MAILERSEND_API_URL=https://api.mailersend.com/v1/email
MAILERSEND_SENDER_EMAIL=noreply@souklab.dz
MAILERSEND_SENDER_NAME=Souklab

# Chargily Pay V2 Integration
CHARGILY_API_KEY=test_api_key_here
CHARGILY_SECRET_KEY=test_secret_key_here
CHARGILY_MODE=test
CHARGILY_WEBHOOK_SECRET=

# Admin Seeder
APP_ADMIN_DEFAULT_PASSWORD=your_admin_seed_password_here

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Levels (TRACE, DEBUG, INFO, WARN, ERROR)
APP_LOGGING_LEVEL_ROOT=INFO
APP_LOGGING_LEVEL_APP=DEBUG
APP_LOGGING_LEVEL_SEARCH=INFO
APP_LOGGING_LEVEL_SEARCH_REQUESTS=DEBUG
APP_LOGGING_LEVEL_ELASTICSEARCH=INFO
